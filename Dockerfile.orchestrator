# Dokploy schedule launcher: runs scripts/dokploy-refresh.sh against the host Docker socket,
# so the schedule no longer depends on a copy of the script installed on the host.
FROM docker@sha256:000bb62ff495f986c9f5578eb67cc2cb98b91138eda81d7762d5371eb8a497fe
COPY scripts/dokploy-refresh.sh /usr/local/bin/media-refresh
ENTRYPOINT ["sh", "/usr/local/bin/media-refresh"]
